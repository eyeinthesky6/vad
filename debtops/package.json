{
  "name": "debtops",
  "version": "0.2.0",
  "description": "Turn static-analysis noise into owner-routed, reviewable fix packets for AI-built codebases.",
  "type": "commonjs",
  "bin": {
    "debtops": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "debtops.config.example.json"
  ],
  "scripts": {
    "audit": "node src/cli.js audit",
    "demo": "node src/cli.js demo",
    "init": "node src/cli.js init",
    "smoke": "node src/cli.js demo",
    "test": "node --test tests/*.test.js",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:dry"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyeinthesky6/vad.git",
    "directory": "debtops"
  },
  "bugs": {
    "url": "https://github.com/eyeinthesky6/vad/issues"
  },
  "homepage": "https://github.com/eyeinthesky6/vad/tree/main/debtops#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "technical-debt",
    "code-audit",
    "static-analysis",
    "sarif",
    "codeowners",
    "ai-code",
    "developer-tools"
  ],
  "author": "SeDroid / eyeinthesky6",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
