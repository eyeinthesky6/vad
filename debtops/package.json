    "demo": "node src/cli.js demo",
    "init": "node src/cli.js init",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "technical-debt",
    "code-audit",
    "static-analysis",
    "sarif",
    "codeowners",
    "ai-code",
    "developer-tools"
  ],
